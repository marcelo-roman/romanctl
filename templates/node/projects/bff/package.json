{
  "name": "sample-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/api",
    "apps/bff",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api & npm run dev -w apps/bff & npm run dev -w apps/web & wait",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "test": "tsc --noEmit && npm test --workspaces && vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
