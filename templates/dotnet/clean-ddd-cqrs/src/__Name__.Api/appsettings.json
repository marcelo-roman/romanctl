{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
{{- if .Postgres}}
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database={{.DbName}};Username=postgres;Password=postgres"
  },
{{- end}}
  "AllowedHosts": "*"
}
